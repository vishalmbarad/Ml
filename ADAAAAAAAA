BINARY SEARCH ( RECURSIVE APPROACH)
#include<stdio.h>
#include<conio.h>
int arr[10],n; //global variable
int binary_search(int beg,int end,int key)
{
int mid;
if(beg==end)
{
if(arr[beg]==key)
{
return beg;
}
else
{
return -1;
}
}
else
{
mid = (beg+end)/2;
if(arr[mid]==key)
{

return mid;
}
else if(key<arr[mid])
{
return binary_search(beg,mid-1,key);
}
else
{
return binary_search(mid+1,end,key);
}
}
}
