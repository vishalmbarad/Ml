{
ratio[i] = profit[i]/weight[i];
}
//sort data in terms of ratio(profit/weight) in
descending order
for(i=0;i<n-1;i++)
{
for(j=i+1;j<n;j++)
{
if(ratio[i]<ratio[j])
{
temp = ratio[i];
ratio[i] = ratio[j];
ratio[j] = temp;

temp = weight[i];
weight[i] = weight[j];
weight[j] = temp;

temp = profit[i];
