BINARY SEARCH ( ITERATIVE APPROACH)
#include<stdio.h>
#include<conio.h>
int binary_search(int arr, int n, int key)
{
int beg=0;
int end = n-1;
int mid = 0;
while(beg<=end)
{
mid = (beg+end)/2;
if arr[mid]==key
{
return mid;
}
else if (arr[mid] > key)
{
end = mid -1;
}
else
{
beg = mid + 1;
}

}
return -1;
}
