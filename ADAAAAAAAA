void insertion_sort(int arr[],int n)
{
int i,j,key;
for(i=1;i<n;i++)
{
key = arr[i];
for(j = i -1 ;j>=0 && arr[j]>key;j--)
{
arr[j+1] = arr[j];
print_arr(arr,n);
}
arr[j+1] = key;
printf("\n\n Disaplaying arrar elements after interatioon : %d",i+1);

print_arr(arr,n);
}
}
