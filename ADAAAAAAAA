FRACTIONAL KNAPSACK PROBLEM
#include<stdio.h>
#include<conio.h>
float x[10],weight[10],profit[10],ratio[10],capacity;
int n;
void knapsack()
{
int i;
float tp=0,rc=capacity;
for(i=0;i<n;i++)
{
if(weight[i]>rc)
{
break;
}
else
{
rc = rc - weight[i];
tp = tp + profit[i];

}
}
if(i<n)
{
tp = tp + ((rc / weight[i] ) * profit[i])
}
printf("\n Profit = %f ",tp);

}
void main()
{
int i,j;
float temp;
clrscr();
